# Root-only ignored directories
/results/
/output/
/optogpt_data/
/model/
/dataset/
/.claude/
/.vscode/
/generated_samples/
/public/
/checkpoints/
/outputs/
/prework_optogpt/
/.worktrees/

# Ignore same-name directories anywhere
**/__pycache__/
**/.ipynb_checkpoints/
**/.pytest_cache/
**/wandb/

# Ignore file suffixes globally
*.log
*.tmp

# Ignore specific files
config.yaml
.env

# Ignore specific file patterns under paths
logs/*.log
outputs/**/*.png

# Keep selected tracked docs/files if broader rules are added later
!data/README.md
